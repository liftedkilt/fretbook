{
  "name": "fretbook-web",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gp-cli": "vite build -c vite.gp-cli.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api-types": "openapi-typescript ../openapi.json -o src/lib/api-types.ts --alphabetize --root-types --root-types-no-schema-prefix",
    "api-types:check": "openapi-typescript ../openapi.json -o src/lib/api-types.ts --alphabetize --root-types --root-types-no-schema-prefix --check || (echo 'API types are stale: run npm run api-types --prefix web and commit web/src/lib/api-types.ts' && exit 1)",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "docs:screenshots": "npm run build && playwright test -c playwright.docs.config.ts",
    "e2e:install": "playwright install chromium",
    "check:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@coderline/alphatab-vite": "1.8.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}

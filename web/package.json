{
  "name": "fretbook-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "api-types": "openapi-typescript ../openapi.json -o src/lib/api-types.ts --alphabetize --root-types --root-types-no-schema-prefix",
    "api-types:check": "openapi-typescript ../openapi.json -o src/lib/api-types.ts --alphabetize --root-types --root-types-no-schema-prefix --check || (echo 'API types are stale: run npm run api-types --prefix web and commit web/src/lib/api-types.ts' && exit 1)",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "e2e:install": "playwright install chromium",
    "check:e2e": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "1.8.4",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
